        "import numpy as np\n",
        "\n",
        "data = np.array([1, 2, 3, 8, 9, 10])\n",
        "\n",
        "m1, m2 = 2.0, 8.0\n",
        "v1, v2 = 1.0, 1.0\n",
        "w1, w2 = 0.5, 0.5\n",
        "\n",
        "for i in range(10):\n",
        "    p1 = w1 * np.exp(-(data-m1)**2/(2*v1)) / np.sqrt(2*np.pi*v1)\n",
        "    p2 = w2 * np.exp(-(data-m2)**2/(2*v2)) / np.sqrt(2*np.pi*v2)\n",
        "\n",
        "    r1 = p1 / (p1+p2)\n",
        "    r2 = 1-r1\n",
        "\n",
        "    w1, w2 = r1.mean(), r2.mean()\n",
        "    m1 = np.sum(r1*data)/np.sum(r1)\n",
        "    m2 = np.sum(r2*data)/np.sum(r2)\n",
        "\n",
        "print(\"Mean 1:\", round(m1, 2))\n",
        "print(\"Mean 2:\", round(m2, 2))\n",
        "print(\"EM Algorithm Completed\")"
      ]
