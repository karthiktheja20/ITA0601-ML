        "\n",
        "model = Perceptron()\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "pred = model.predict(X_test)\n",
        "\n",
        "print(\"Predicted Values:\", pred)\n",
        "print(\"Accuracy:\", accuracy_score(y_test, pred))"
